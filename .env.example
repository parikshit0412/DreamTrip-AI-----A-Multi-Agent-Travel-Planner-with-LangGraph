# ==============================================================================
# DreamTrip AI — Environment Configuration Template
# ==============================================================================
# Duplicate this file to '.env' and populate with your credentials.

# 1. Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Model name (defaults to 'gemini-2.5-flash' for standard 1,500 requests/day quota)
GEMINI_MODEL=gemini-2.5-flash

# 2. PostgreSQL Connection URL (Required for LangGraph PostgresSaver checkpointer)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/dreamtrip?sslmode=require

# 3. AviationStack API Key (Required for Flight Agent)
# Obtain from: https://aviationstack.com/
AVIATIONSTACK_API_KEY=your_aviationstack_key_here

# 4. Tavily Search API Key (Required for Hotel & Destination Discovery Agent)
# Obtain from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# 5. OpenWeather API Key (Required for Weather Agent FastMCP Server)
# Obtain from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# 6. Redis URL (Optional - defaults to redis://localhost:6379/0 or redis://redis:6379/0 in Docker)
REDIS_URL=redis://localhost:6379/0

# 7. Default Departure Airport IATA Code (Optional - defaults to DAC / Dhaka)
DEFAULT_ORIGIN_IATA=KOL
